{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "short_name": "EasyYTD",
  "description": "__MSG_extDescription__",
  "version": "0.1.2",
  "default_locale": "en",
  "homepage_url": "https://github.com/eeeyyeeezz/EasyYTubeDownloader",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "__MSG_extName__",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "permissions": [
    "contextMenus",
    "activeTab"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
