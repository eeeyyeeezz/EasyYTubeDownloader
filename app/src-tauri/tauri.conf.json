{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EasyYTubeDownloader",
  "version": "0.1.2",
  "identifier": "io.github.eeeyyeeezz.easyytd",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "EasyYTubeDownloader",
        "width": 640,
        "height": 720,
        "minWidth": 460,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' data: https://i.ytimg.com https://*.ytimg.com https://*.googleusercontent.com; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "easyytd"
        ]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE1QUQxOThENjI3OEQyREEKUldUYTBuaGlqUm10cFNXVDQ1MUgza1NMR0JlRFNsdlRKSmV1cFYrekM3WDNmNHBGVUMvUk9MUDkK",
      "endpoints": [
        "https://github.com/eeeyyeeezz/EasyYTubeDownloader/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Video",
    "publisher": "eeeyyeeezz",
    "copyright": "MIT License",
    "homepage": "https://github.com/eeeyyeeezz/EasyYTubeDownloader",
    "shortDescription": "Simple YouTube downloader",
    "longDescription": "Download YouTube videos and audio in one click. A friendly desktop app built on yt-dlp with a browser extension for Chrome and Firefox.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "10.15"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English",
          "Russian"
        ],
        "displayLanguageSelector": false
      }
    },
    "createUpdaterArtifacts": false
  }
}
